[rendering]

renderer/rendering_method="forward_plus"
; Web and mobile have no Vulkan path, so they run Compatibility. The screen-space
; ink pass detects that at runtime and switches itself off — outlines still draw.
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
